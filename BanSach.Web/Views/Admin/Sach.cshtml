@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="tieu-de-trang">
    <h1>Sách</h1>
    <button type="button" class="btn btn-primary" id="nutThem">+ Thêm sách</button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="search" class="form-control" id="locTuKhoa" placeholder="Tìm tên sách, tác giả (gõ không dấu cũng được)">
    </div>
    <div class="col-6 col-md-4">
        <select class="form-select" id="locTheLoai">
            <option value="">Tất cả thể loại</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select class="form-select" id="locSapXep">
            <option value="ma">Theo mã sách</option>
            <option value="ten">Tên A → Z</option>
            <option value="gia-tang">Giá tăng dần</option>
            <option value="gia-giam">Giá giảm dần</option>
            <option value="moi">Năm xuất bản mới nhất</option>
            <option value="ton-it">Tồn kho ít nhất</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover bang-quan-tri">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Mã</th>
                <th>Tên sách</th>
                <th>Thể loại</th>
                <th class="text-end">Giá bán</th>
                <th class="text-end">Tồn</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="bangSach">
            <tr><td colspan="7" class="text-muted">Đang tải...</td></tr>
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center">
    <div class="small text-muted" id="tongSoSach"></div>
    <nav id="phanTrangSach"></nav>
</div>

<div class="modal fade" id="modalSach" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="formSach" novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="tieuDeModal">Thêm sách</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" data-khung-loi></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="tenSach" class="form-label">Tên sách <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="tenSach" maxlength="200" required>
                            </div>
                            <div class="col-md-6">
                                <label for="maTheLoai" class="form-label">Thể loại <span class="text-danger">*</span></label>
                                <select class="form-select" id="maTheLoai" required></select>
                            </div>
                            <div class="col-md-6">
                                <label for="tacGia" class="form-label">Tác giả <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="tacGia" maxlength="100" required>
                            </div>
                            <div class="col-md-6">
                                <label for="nhaXuatBan" class="form-label">Nhà xuất bản <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="nhaXuatBan" maxlength="100" required>
                            </div>
                            <div class="col-md-6">
                                <label for="namXuatBan" class="form-label">Năm xuất bản <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="namXuatBan" min="1900" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label for="giaBan" class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="giaBan" min="1" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label for="soLuongTon" class="form-label">Số lượng tồn <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="soLuongTon" min="0" step="1" required>
                            </div>
                            <div class="col-12">
                                <label for="moTaSach" class="form-label">Mô tả</label>
                                <textarea class="form-control" id="moTaSach" rows="3" maxlength="2000"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label d-block">Ảnh bìa</label>
                        <img src="/images/sach/no-image.png" class="anh-bia-xem-truoc mb-2 d-block" id="xemTruocAnh" alt="Ảnh bìa">
                        <input type="file" class="form-control form-control-sm" id="fileAnh" accept=".jpg,.jpeg,.png,.webp">
                        <div class="form-text">JPG, PNG hoặc WEBP, tối đa 2MB.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary" id="nutLuu">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/sach.js" asp-append-version="true"></script>
}
